{
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/reminders/daily-brief",
      "schedule": "30 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
